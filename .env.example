# MySQL Configuration
# REQUIRED: Set a strong, unique password for the MySQL root account
MYSQL_ROOT_PASSWORD=

# REQUIRED: Set a strong, unique password for the application database user
MYSQL_PASSWORD=

# OPTIONAL: Application database username (defaults to lifeandroads_app)
# MYSQL_USER=lifeandroads_app

# Application Configuration
# REQUIRED: Set a strong, unique secret for JWT token signing
JWT_SECRET=

# OPTIONAL: CORS origin configuration (defaults to empty, allowing all origins)
# CORS_ORIGIN=https://example.com
