PORT=3001
APP_ENV=development
DB_HOST=127.0.0.1
DB_USER=life_and_roads
DB_PASSWORD=gere-uma-senha-forte
DB_NAME=life_and_roads
DB_PORT=3306
# Certificado CA do banco remoto em Base64. Deixe vazio apenas no MySQL local.
DB_SSL_CA_BASE64=
JWT_SECRET=gere-pelo-menos-32-bytes-aleatorios
CORS_ORIGIN=
# Proxies confiáveis na frente da API (Render: 1; exposta direto: 0).
TRUST_PROXY=0
# Opcional. Chave do Resend para enviar o código de recuperação de senha.
# Sem ela, em produção a rota /auth/recuperar responde 503; fora de
# produção o código vai para o log.
RESEND_API_KEY=
# Opcional. Remetente dos e-mails; o padrão é life.and.roads <no-reply@raulnikroyce.dev>.
EMAIL_REMETENTE=
